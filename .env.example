# --- Core (required) ---
# Neon Postgres connection string
DATABASE_URL="postgresql://user:password@host/homeroom?sslmode=require"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Payments (required for checkout) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Email (transactional; Kit stays the marketing channel) ---
RESEND_API_KEY=""

# --- Video ---
VIMEO_ACCESS_TOKEN=""

# --- Integrations (optional) ---
KIT_API_KEY=""
SLACK_WEBHOOK_URL=""

# --- Salesforce (Apex exercises run in an org the learner connects) ---
# External Client App with PKCE + refresh token rotation, callback at
# $NEXT_PUBLIC_APP_URL/api/salesforce/callback
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
# Encrypts stored refresh tokens. Generate with: openssl rand -base64 32
SALESFORCE_TOKEN_KEY=""

# --- Agent ---
# Vercel AI Gateway key (or set ANTHROPIC_API_KEY for direct provider access)
AI_GATEWAY_API_KEY=""
ANTHROPIC_API_KEY=""
# Used for Whisper transcript generation when the video host has no captions
OPENAI_API_KEY=""
